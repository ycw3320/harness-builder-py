      "title": ".env 쓰기 차단 (시크릿 보호)",
      "involvement": "manual-gate",
      "enabled": true,
      "event": "PreToolUse",
      "matcherTool": "Write|Edit",
      "pathGlob": "**/.env*",
      "action": "deny",
      "scriptName": "block-secrets.sh",
      "scriptBody": "#!/usr/bin/env bash\n# .env* 파일 쓰기 차단 — 시크릿 보호 (강제수준 3단: hook)\ninput=$(cat)\npath=$(printf '%s' \"$input\" | grep -oE '\"file_path\"[[:space:]]*:[[:space:]]*\"[^\"]*\"' | head -1)\ncase \"$path\" in\n  *.env*) echo \"차단: .env 파일에는 쓸 수 없습니다 (시크릿 보호)\" >&2; exit 2;;\nesac\nexit 0",
      "intent": {
        "raw": "비밀키 파일을 못 쓰게 막아",
        "compiledBy": "preset",
        "confidence": 1
      }
